# Instincta Android APK uses zero embedded developer secrets so it is safe to open-source and share.
# Do NOT put INSTAGRAM_APP_SECRET in this Android file.
# Server-side OAuth secrets belong in rust/server/.env (see rust/server/.env.example).

# GEMINI_API_KEY: Unused in Instincta.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
